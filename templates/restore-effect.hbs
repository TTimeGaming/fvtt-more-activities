<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    <fieldset class="collapsible-fieldset" data-expanded="true" data-fieldset-id="restore-configuration">
        <legend class="collapsible-legend">
            <i class="fas fa-chevron-down collapse-arrow"></i>
            <label> Configuration </label>
        </legend>

        <div class="fieldset-content">
            <div class="form-group stacked">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.restore.itemName.label"}}</label>
                <div class="form-fields">
                    <input type="text" name="targetItemName" value="{{ targetItemName }}" placeholder="Wand of Magic Missiles">
                </div>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.restore.itemName.hint"}}</p>
            </div>

            <div class="form-group stacked">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.restore.matchContains.label"}}</label>
                <div class="form-fields">
                    <dnd5e-checkbox name="matchContains" {{#if matchContains}}checked{{/if}}></dnd5e-checkbox>
                </div>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.restore.matchContains.hint"}}</p>
            </div>

            <div class="form-group stacked">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.restore.restoreAmount.label"}}</label>
                <div class="form-fields">
                    <input type="text" name="restoreAmount" value="{{ restoreAmount }}" placeholder="1d8, 2d4+1, 10, -1" {{#if restoreToMax}}disabled{{/if}}>
                </div>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.restore.restoreAmount.hint"}}</p>
            </div>

            <div class="form-group stacked">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.restore.restoreToMax.label"}}</label>
                <div class="form-fields">
                    <dnd5e-checkbox name="restoreToMax" {{#if restoreToMax}}checked{{/if}}></dnd5e-checkbox>
                </div>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.restore.restoreToMax.hint"}}</p>
            </div>
        </div>
    </fieldset>
</section>
