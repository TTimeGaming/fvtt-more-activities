<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    <fieldset class="collapsible-fieldset" data-expanded="true" data-fieldset-id="macro-macro">
        <legend class="collapsible-legend">
            <i class="fas fa-chevron-down collapse-arrow"></i>
            <label> Macro </label>
        </legend>

        <div class="fieldset-content">
            <div class="form-group">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.macro.macroSource.label"}}</label>
                <div class="form-fields">
                    <select name="macroSource">
                        <option value="code" {{#if (eq macroSource "code")}}selected{{/if}}>{{localize "DND5E.ACTIVITY.FIELDS.macro.macroSource.choices.code"}}</option>
                        <option value="world" {{#if (eq macroSource "world")}}selected{{/if}}>{{localize "DND5E.ACTIVITY.FIELDS.macro.macroSource.choices.world"}}</option>
                    </select>
                </div>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.macro.macroSource.hint"}}</p>
            </div>

            {{#if (eq macroSource "world")}}
            <div class="form-group">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.macro.worldMacroId.label"}}</label>
                <div class="form-fields">
                    <select name="worldMacroId">
                        <option value="">{{localize "DND5E.ACTIVITY.FIELDS.macro.worldMacroId.placeholder"}}</option>
                        {{#each availableMacros as |macro|}}
                            <option value="{{ macro.id }}" {{#if macro.selected}}selected{{/if}}>
                                {{ macro.name }} ({{ macro.type }})
                            </option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.macro.worldMacroId.hint"}}</p>
            </div>
            {{else}}
            <div class="form-group">
                <label>{{localize "DND5E.ACTIVITY.FIELDS.macro.macroCode.label"}}</label>
                <p class="hint">{{localize "DND5E.ACTIVITY.FIELDS.macro.macroCode.hint"}}</p>
            </div>
            
            <div class="form-group macro-editor-container">
                <div class="code-editor-wrapper">
                    {{#if (eq version 12)}}
                    <textarea name="macroCode" aria-label="Macro Code">{{ macroCode }}</textarea>
                    {{else}}
                    <code-mirror name="macroCode" language="javascript" indent="2" aria-label="Macro Code">{{ macroCode }}</code-mirror>
                    {{/if}}
                </div>
            </div>
            {{/if}}
        </div>
    </fieldset>
</section>
